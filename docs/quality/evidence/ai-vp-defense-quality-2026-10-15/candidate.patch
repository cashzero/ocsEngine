+/** Allocate scarce defenders by the VP exposed, normalized to preserve uniform maps.
+ * At least one existing garrison is still reserved independently of this value. */
+export const objectiveDefenseValue = (situation: Pick<Situation, 'objectives'>, hexId: HexId): number => {
+  const objective = situation.objectives.find(o => o.hexId === hexId);
+  const mean = situation.objectives.reduce((total, o) => total + o.points, 0) / Math.max(1, situation.objectives.length);
+  return objective && mean > 0 ? objective.points / mean : 1;
+};
 
