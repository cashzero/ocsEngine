diff --git a/tests/ai/artillery-mode.test.ts b/tests/ai/artillery-mode.test.ts
new file mode 100644
index 0000000..a6c113c
--- /dev/null
+++ b/tests/ai/artillery-mode.test.ts
@@ -0,0 +1,67 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { gunzipSync } from 'node:zlib';
+import { describe, expect, it } from 'vitest';
+import {
+  createBotRng, createHeuristicPolicy, parseGameStateJson, ruleEngine,
+  type BotDecisionContext, type BotPhaseMemory, type GameState,
+} from '../../src/index.js';
+
+const context = (state: GameState, memory: BotPhaseMemory): BotDecisionContext => {
+  const actorId = state.pendingDecision?.ownerId ?? state.sequence.actingPlayerId;
+  return {
+    seatId: 'seat:regression' as BotDecisionContext['seatId'], playerId: actorId, memory,
+    rng: createBotRng(7, 'artillery-mode', 0),
+    view: { projection: ruleEngine.projectForViewer(state, actorId), pendingDecision: state.pendingDecision } as unknown as BotDecisionContext['view'],
+    actions: {
+      families: () => ruleEngine.getActionFamilies(state, actorId).filter(f => f.enabled).map(f => f.kind),
+      movementRange: id => ruleEngine.queryMovementRange(state, actorId, id).value!,
+      candidates: (kind, pieceId = null, budget = 400) => ruleEngine.getActionCandidates(state, { actorId, kind, pieceId, budget }).actions,
+      explain: action => ({ current: true, explanation: ruleEngine.explain(state, action) }),
+      traceCoverage: (id = null) => ruleEngine.queryTraceCoverage(state, actorId, id).value!,
+      feedCoverage: (id = null) => ruleEngine.queryFeedCoverage(state, actorId, id).value!,
+      drawReach: hexId => new Set((ruleEngine.queryDrawReach(state, actorId, hexId).value ?? []).map(String)),
+    },
+  };
+};
+
+const isArtillery = (state: GameState, pieceId: string) => {
+  const piece = state.pieceState.pieces.find(p => p.id === pieceId)!;
+  return /artillery/.test(String(state.scenario.pieceCatalog.definitions.find(d => d.id === piece.definitionId)?.categoryDefinitionId));
+};
+
+describe('AI artillery fires from its Combat side', () => {
+  it('turns guns already in range to Combat Mode as they begin to move, and barrages from it', () => {
+    // Recorded attack game (seed 1300205, Axis attacks, turn 4): eight Axis guns stand in 12,10 two hexes from the enemy,
+    // within their range of 2, all in Move Mode. heuristic@79 left them there and barraged at Move Mode strength.
+    const fixture = JSON.parse(gunzipSync(readFileSync(join(__dirname, 'fixtures', 'artillery-mode-1300205.state.json.gz'))).toString()) as { snapshot: string };
+    const parsed = parseGameStateJson(fixture.snapshot);
+    if (!parsed.ok) throw new Error('Invalid recorded game');
+    let state = parsed.value;
+    const playerId = state.sequence.actingPlayerId;
+    const guns = state.pieceState.pieces.filter(p => p.ownerId === playerId && p.location.kind === 'ON_MAP' && isArtillery(state, p.id)).map(p => p.id);
+    expect(guns).toHaveLength(8);
+    expect(state.pieceState.pieces.filter(p => guns.includes(p.id)).every(p => p.mode === 'MOVE')).toBe(true);
+
+    const policy = createHeuristicPolicy({ scenario: state.scenario, turnLimit: state.configuration.turnLimit });
+    let memory: BotPhaseMemory = { stepKey: 'MOVEMENT', actions: 0, notes: new Map() };
+    const barrages: (typeof guns)[] = [];
+    for (let guard = 0; guard < 400 && !(state.sequence.phase === 'COMBAT' && state.sequence.segment === 'COMBAT'); guard++) {
+      const key = `${state.sequence.phase}:${state.sequence.segment}`;
+      if (memory.stepKey !== key) memory = { stepKey: key, actions: 0, notes: new Map() };
+      const choice = policy.decide(context(state, memory));
+      expect(choice).not.toBeNull();
+      if (!choice) break;
+      if (choice.action.kind === 'DECLARE_BARRAGE') barrages.push([...choice.action.firerIds]);
+      const next = ruleEngine.applyAction(state, choice.action);
+      expect(next.ok, JSON.stringify(choice.action)).toBe(true);
+      if (!next.ok) break;
+      state = next.state;
+    }
+
+    expect(state.sequence).toMatchObject({ phase: 'COMBAT', segment: 'COMBAT' });
+    const fired = barrages.flat();
+    expect(fired.length).toBeGreaterThan(0);
+    expect(fired.every(id => guns.includes(id) && state.pieceState.pieces.find(p => p.id === id)!.mode === 'COMBAT')).toBe(true);
+  }, 120_000);
+});
