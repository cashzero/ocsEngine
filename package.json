{
  "name": "ocs-engine",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run ui:serve",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "smoke": "node tests/dist-smoke.mjs",
    "test": "vitest run",
    "test:sweep": "OCS_SWEEP=1 vitest run tests/generation/seed-sweep.test.ts tests/generation/oob-seed-sweep.test.ts tests/rules/trace-coverage-equivalence.test.ts tests/rules/reinforcement-hexes-equivalence.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "ui:serve": "npm run build && node scripts/serve-ui.mjs",
    "ui:layout-audit": "node scripts/ui-layout-audit.mjs",
    "ai:match": "npm run build && node scripts/ai-match.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "typescript": "~5.8.2",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "lit-html": "^3.3.3"
  }
}
